# Copy to `.env` and adjust. Every variable is optional — unset ones fall back
# to the defaults in config/config.py. `.env` is gitignored.

# Appium server (override to point at a remote grid / device farm)
# APPIUM_SERVER=http://localhost:4723

# Waits (seconds)
# IMPLICIT_TIMEOUT=10
# EXPLICIT_TIMEOUT=20

# --- Android ---
# ANDROID_AUTOMATION_NAME=UiAutomator2
# ANDROID_DEVICE_NAME=Android Emulator
# ANDROID_PLATFORM_VERSION=13.0
# ANDROID_APP=/abs/path/to/android-app.apk
# ANDROID_APP_PACKAGE=com.example.app
# ANDROID_APP_ACTIVITY=.MainActivity
# ANDROID_AUTO_GRANT_PERMISSIONS=true
# ANDROID_NO_RESET=false

# --- iOS ---
# IOS_AUTOMATION_NAME=XCUITest
# IOS_DEVICE_NAME=iPhone 14
# IOS_PLATFORM_VERSION=16.0
# IOS_APP=/abs/path/to/ios-app.app
# IOS_BUNDLE_ID=com.example.app
# IOS_NO_RESET=false
